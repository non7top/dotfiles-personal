[dotfiles]
ignore = [
    '.git',
    '.gitignore',
    '.github',
    '.dotfilesrc',
    '.claude',
    '.pre-commit-config.yaml',
    'bootstrap.sh',
    'Makefile',
    'Dockerfile*',
    'docker-compose.yml',
    'tests',
    '*.swp',
    'LICENSE',
    'README.rst'
    ]
prefix = _
packages = [
    'claude',
    'gemini',
    ]
