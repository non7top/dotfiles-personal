#!/usr/bin/env bash

# gcl: git-cleanup-remote-and-local-branches
#
# Cleaning up remote and local branch is delivered as follows:
# 1. Prune remote branches when they are deleted or merged
# 2. Remove local branches when their remote branches are removed
# 3. Remove local branches when a master included squash and merge commits
# 4. Remove local branches that have no commits beyond origin/<default branch>
#
# Linked worktrees whose branch is merged or squash-merged are removed first,
# otherwise their branches cannot be deleted. Dirty and locked worktrees, and
# ones mid-rebase/merge/bisect, are skipped. So are worktrees holding ignored
# files that are not known to be regenerable, unless -f is given.
#
# Usage: git gcl [-n] [-f]
#   -n  dry run, only list what would be removed (previews -r too)
#   -f  also remove worktrees holding non-regenerable ignored files
#   -r  also delete merged and squash-merged branches on origin

DRY_RUN=0
FORCE=0
REMOTE_DELETE=0
while getopts nfr opt; do
  case $opt in
    n) DRY_RUN=1 ;;
    f) FORCE=1 ;;
    r) REMOTE_DELETE=1 ;;
    *) echo "usage: git gcl [-n] [-f] [-r]" >&2; exit 2 ;;
  esac
done

# Ignored entries (by basename) that are safe to lose with a worktree
REGENERABLE='node_modules __pycache__ .venv build dist target .pytest_cache .terraform vendor .phpunit.result.cache'

if [[ -t 1 && -z ${NO_COLOR:-} ]]; then
  C_BOLD=$'\e[1m' C_DIM=$'\e[2m' C_GREEN=$'\e[32m' C_YELLOW=$'\e[33m' C_OFF=$'\e[0m'
fi

function say_start() { echo "${C_BOLD}$*${C_OFF}"; }
function say_finish() { echo "${C_DIM}$*${C_OFF}"; }
function say_skip() { echo "${C_YELLOW}$*${C_OFF}"; }
function say_note() { echo "${C_DIM}$*${C_OFF}"; }

# Runs a mutating command, or only prints it in dry-run mode
function act() {
  if [[ $DRY_RUN == 1 ]]; then echo "${C_GREEN}would run: $*${C_OFF}"; else "$@"; fi
}

function git_prune_remote() {
  say_start "Start removing out-dated remote merged branches"
  act git fetch --prune
  say_finish "Finish removing out-dated remote merged branches"
}

# Branches already handled or reported, so later steps don't repeat them
declare -A REPORTED
# Branches whose worktree was (or, in dry run, would be) removed
declare -A WORKTREE_REMOVED

function branch_worktree() {
  [[ -n ${WORKTREE_REMOVED[$1]} ]] || git for-each-ref --format='%(worktreepath)' "refs/heads/$1"
}

function git_remove_merged_local_branch() {
  say_start "Start removing out-dated local merged branches"
  local default line mark branch
  default=$(git sd)
  while IFS= read -r line; do
    mark=${line:0:2} branch=${line:2}
    [[ $branch == "$default" ]] && continue
    case $mark in
      "* ") say_skip "Skip branch $branch: current branch"; REPORTED[$branch]=1 ;;
      "+ ")
        if [[ -n ${WORKTREE_REMOVED[$branch]} ]]; then
          act git branch -d "$branch" && REPORTED[$branch]=1
        else
          say_skip "Skip branch $branch: checked out in $(branch_worktree "$branch")"; REPORTED[$branch]=1
        fi ;;
      *) act git branch -d "$branch" && REPORTED[$branch]=1 ;;
    esac
  done < <(git branch --merged)
  say_finish "Finish removing out-dated local merged branches"
}

# $1=ref $2=base (default: the default branch)
function is_squash_merged() {
  local branch=$1 base=${2:-$(git sd)} ancestor
  ancestor=$(git merge-base "$base" "$branch") &&
    [[ $(git cherry "$base" "$(git commit-tree "$(git rev-parse "$branch^{tree}")" -p "$ancestor" -m _)") == "-"* ]]
}

# $1=ref $2=base (default: the default branch)
# A branch whose non-merge commits were all applied to base (e.g. cherry-picked
# or rebased individually, or landed via separate PRs). git cherry reports
# applied commits with '-' and unapplied commits with '+'.
function is_cherry_merged() {
  local branch=$1 base=${2:-$(git sd)} cherry_out
  cherry_out=$(git cherry "$base" "$branch" 2>/dev/null) || return 1
  if [[ -n $cherry_out ]]; then
    [[ $(grep -c '^+ ' <<< "$cherry_out") -eq 0 ]]
  else
    [[ $(git rev-list --count "$base..$branch" 2>/dev/null) -gt 0 ]] && [[ -z $(git diff "$base...$branch" 2>/dev/null) ]]
  fi
}

# Checks if a merged GitHub PR exists with the same head SHA as $branch
function is_gh_pr_merged() {
  local branch=$1 head_sha pr_info
  command -v gh &>/dev/null || return 1
  head_sha=$(git rev-parse "$branch" 2>/dev/null) || return 1
  pr_info=$(gh pr list --state merged --head "$branch" --json headRefOid,baseRefName,number --jq '.[0] | "\(.headRefOid) \(.baseRefName) #\(.number)"' 2>/dev/null) || return 1
  [[ -z $pr_info || $pr_info == "null null #"* ]] && return 1
  local pr_sha pr_base pr_num
  read -r pr_sha pr_base pr_num <<< "$pr_info"
  [[ $pr_sha == "$head_sha" ]]
}

# Checks if $branch is an ancestor of another remote branch on origin
function merged_into_remote_branch() {
  local branch=$1 default=${2:-$(git sd)} remote_ref remote_name
  for remote_ref in $(git for-each-ref --format='%(refname:short)' refs/remotes/origin/); do
    remote_name=${remote_ref#origin/}
    [[ $remote_name == "HEAD" || $remote_name == "$default" || $remote_name == "$branch" ]] && continue
    if git merge-base --is-ancestor "$branch" "$remote_ref" 2>/dev/null; then
      echo "$remote_ref"
      return 0
    fi
  done
  return 1
}

# Generates a diagnostic skip reason for an unmerged branch
function branch_skip_reason() {
  local branch=$1 base=${2:-$(git sd)}
  local other_remote
  if other_remote=$(merged_into_remote_branch "$branch" "$base"); then
    echo "merged into $other_remote"
    return
  fi
  local counts ahead behind unapplied
  counts=$(git rev-list --left-right --count "$base...$branch" 2>/dev/null)
  behind=$(awk '{print $1}' <<< "$counts")
  ahead=$(awk '{print $2}' <<< "$counts")
  unapplied=$(git cherry "$base" "$branch" 2>/dev/null | grep -c '^+ ' || true)
  echo "not merged (ahead ${ahead:-0}, behind ${behind:-0}; ${unapplied:-0} unapplied)"
}

# $1=ref $2=base
function is_branch_merged() {
  local ref=$1 base=${2:-$(git sd)}
  git merge-base --is-ancestor "$ref" "$base" || is_squash_merged "$ref" "$base" || is_cherry_merged "$ref" "$base" || is_gh_pr_merged "$ref"
}

# A mid-rebase worktree looks detached at an old, "merged" commit
function worktree_in_progress() {
  local gd name
  gd=$(git -C "$1" rev-parse --absolute-git-dir)
  for name in rebase-merge rebase-apply MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD BISECT_LOG; do
    [[ -e $gd/$name ]] && return 0
  done
  return 1
}

# Prints the ignored top-level entries of worktree $1 that are not regenerable
function worktree_ignored_files() {
  local line entry pat skip
  git -C "$1" status --porcelain --ignored=matching | while IFS= read -r line; do
    [[ $line == "!! "* ]] || continue
    entry=${line#!! }
    entry=$(basename "$entry")
    skip=0
    for pat in $REGENERABLE; do
      # shellcheck disable=SC2254
      case $entry in $pat) skip=1 ;; esac
    done
    [[ $skip == 1 ]] || echo "$entry"
  done
}

# $1=path $2=branch (empty if detached) $3=HEAD sha $4=locked(1|"")
function git_maybe_remove_worktree() {
  local path=$1 branch=$2 head=$3 locked=$4 default current ref ignored
  default=$(git sd)
  current=$(git rev-parse --show-toplevel)
  ref=${branch:-$head}
  [[ -z $ref || ! -d $path ]] && return
  if ! is_branch_merged "$ref" "$default"; then
    say_skip "Skip worktree $path (${branch:-detached $head}): $(branch_skip_reason "$ref" "$default")"
    return
  fi
  ref=${branch:-detached $head}
  if [[ -n $locked ]]; then
    say_skip "Skip worktree $path ($ref): locked"
  elif worktree_in_progress "$path"; then
    say_skip "Skip worktree $path ($ref): rebase, merge, cherry-pick or bisect in progress"
  elif [[ -n $(git -C "$path" status --porcelain) ]]; then
    say_skip "Skip worktree $path ($ref): uncommitted or untracked files"
  elif [[ $FORCE == 0 ]] && ignored=$(worktree_ignored_files "$path") && [[ -n $ignored ]]; then
    say_skip "Skip worktree $path ($ref): ignored files, use -f to remove: $(echo $ignored)"
  else
    if [[ $path == "$current" ]]; then
      say_note "Removing the current worktree: run 'cd $MAIN_WORKTREE' afterwards"
      [[ $DRY_RUN == 1 ]] || cd "$MAIN_WORKTREE"
    fi
    act git worktree remove "$path"
    [[ -z $branch ]] || WORKTREE_REMOVED[$branch]=1
    say_note "Note: Claude Code transcripts for $path stay under ~/.claude/projects/ but no longer show in this repo's resume list"
  fi
}

function git_remove_merged_worktrees() {
  say_start "Start removing merged worktrees"
  local line path branch head locked first=1
  while IFS= read -r line; do
    case $line in
      "worktree "*) path=${line#worktree } ;;
      "HEAD "*) head=${line#HEAD } ;;
      "branch refs/heads/"*) branch=${line#branch refs/heads/} ;;
      locked*) locked=1 ;;
      "")
        # first entry is the main checkout
        if [[ $first == 1 ]]; then MAIN_WORKTREE=$path; else git_maybe_remove_worktree "$path" "$branch" "$head" "$locked"; fi
        first=0 path= branch= head= locked=
        ;;
    esac
  done < <(git worktree list --porcelain; echo)
  act git worktree prune
  say_finish "Finish removing merged worktrees"
}

# When we use `Squash and merge` on GitHub,
# `git branch --merged` cannot detect the squash-merged branches.
# As a result, git_remove_merged_local_branch() cannot clean up
# unused local branches. This function detects and removes local branches
# when remote branches are squash-merged.
#
# There is an edge case. If you add suggested commits on GitHub,
# the contents in local and remote are different. As a result,
# This clean up function cannot remove local squash-merged branch.
function git_remove_squash_merged_local_branch() {
  say_start "Start removing out-dated local squash-merged branches"
  local default base branch wt
  default=$(git sd)
  base=origin/$default
  git rev-parse --verify -q "$base" >/dev/null 2>&1 || base=$default
  if ! act git cd; then
    say_skip "Skip squash-merged branch check: cannot switch to $default"
    say_finish "Finish removing out-dated local squash-merged branches"
    return
  fi
  while read -r branch; do
    [[ $branch == "$default" || -n ${REPORTED[$branch]} ]] && continue
    if is_squash_merged "$branch" "$base" || is_cherry_merged "$branch" "$base" || is_gh_pr_merged "$branch"; then
      if wt=$(branch_worktree "$branch") && [[ -n $wt ]]; then
        say_skip "Skip branch $branch: checked out in $wt"; REPORTED[$branch]=1
      else
        act git branch -D "$branch" && REPORTED[$branch]=1
      fi
    fi
  done < <(git for-each-ref refs/heads/ "--format=%(refname:short)")
  say_finish "Finish removing out-dated local squash-merged branches"
}

# Branches whose commits are all in origin/<default>, e.g. merged with a merge
# commit while HEAD was on another branch or the local default was stale. The
# checks above compare against HEAD or the local default and miss them.
# Branches at the very tip of origin/<default> have no work of their own yet
# and are kept, like the remote variant does.
function git_remove_upstream_merged_local_branch() {
  say_start "Start removing local branches with no commits beyond origin default"
  local default base branch wt
  default=$(git sd)
  base=origin/$default
  while read -r branch; do
    [[ $branch == "$default" || -n ${REPORTED[$branch]} ]] && continue
    if [[ $(git rev-parse "$branch") == "$(git rev-parse "$base")" ]]; then
      say_skip "Skip branch $branch: no commits of its own"; REPORTED[$branch]=1
    elif [[ $(git rev-list --count "$base..$branch") != 0 ]]; then
      say_skip "Skip branch $branch: $(branch_skip_reason "$branch" "$base")"; REPORTED[$branch]=1
    elif wt=$(branch_worktree "$branch") && [[ -n $wt ]]; then
      say_skip "Skip branch $branch: checked out in $wt"; REPORTED[$branch]=1
    else
      act git branch -D "$branch" && REPORTED[$branch]=1
    fi
  done < <(git for-each-ref refs/heads/ "--format=%(refname:short)")
  say_finish "Finish removing local branches with no commits beyond origin default"
}

# Compared against origin/<default>, not the local default, so only branches
# whose work is on the remote default get deleted.
function git_remove_merged_remote_branches() {
  local default base branch
  if [[ $REMOTE_DELETE == 1 ]]; then
    say_start "Start removing merged remote branches"
  else
    say_start "Start removing merged remote branches (preview only, needs -r)"
  fi
  default=$(git sd)
  base=origin/$default
  while read -r branch; do
    [[ $branch == "HEAD" || $branch == "$default" ]] && continue
    if [[ $(git rev-parse "origin/$branch") == "$(git rev-parse "$base")" ]]; then
      say_skip "Skip remote branch $branch: no commits of its own"
    elif git merge-base --is-ancestor "origin/$branch" "$base" || is_squash_merged "origin/$branch" "$base" || is_cherry_merged "origin/$branch" "$base"; then
      act git push origin --delete "$branch"
    else
      say_skip "Skip remote branch $branch: $(branch_skip_reason "origin/$branch" "$base")"
    fi
  done < <(git for-each-ref --format='%(refname:lstrip=3)' refs/remotes/origin/)
  say_finish "Finish removing merged remote branches"
}

# Report leftover stashes and whether their work was merged into origin/<default>
function git_report_stashes() {
  local stash_list
  stash_list=$(git stash list --format="%gd %h %gs" 2>/dev/null) || return 0
  [[ -z $stash_list ]] && return 0

  say_start "Start checking leftover stashes"
  local default base
  default=$(git sd)
  base=origin/$default
  git rev-parse --verify -q "$base" >/dev/null 2>&1 || base=$default

  local line stash_ref sha msg
  while IFS= read -r line; do
    [[ -z $line ]] && continue
    stash_ref=$(awk '{print $1}' <<< "$line")
    sha=$(awk '{print $2}' <<< "$line")
    msg=$(cut -d' ' -f3- <<< "$line")

    local branch="" branch_status=""
    if [[ $msg =~ (WIP on |On )([^:]+): ]]; then
      branch="${BASH_REMATCH[2]}"
      if git show-ref --verify --quiet "refs/heads/$branch" 2>/dev/null || \
         git show-ref --verify --quiet "refs/remotes/origin/$branch" 2>/dev/null; then
        branch_status="on $branch"
      else
        branch_status="on $branch (branch gone)"
      fi
    fi

    local file blob total_files=0 matched_files=0
    local unmatched=()

    # Tracked files changed in stash
    while IFS= read -r file; do
      [[ -z $file ]] && continue
      ((total_files++))
      blob=$(git rev-parse "$stash_ref:$file" 2>/dev/null) || true
      if [[ -n $blob ]] && git log "$base" -n 1 --find-object="$blob" --format=%H 2>/dev/null | grep -q .; then
        ((matched_files++))
      else
        unmatched+=("$file")
      fi
    done < <(git diff --name-only "$stash_ref^1" "$stash_ref" 2>/dev/null)

    # Untracked files in stash (stash@{N}^3), if any
    if git rev-parse -q --verify "$stash_ref^3" >/dev/null 2>&1; then
      while IFS= read -r file; do
        [[ -z $file ]] && continue
        ((total_files++))
        blob=$(git rev-parse "$stash_ref^3:$file" 2>/dev/null) || true
        if [[ -n $blob ]] && git log "$base" -n 1 --find-object="$blob" --format=%H 2>/dev/null | grep -q .; then
          ((matched_files++))
        else
          unmatched+=("$file")
        fi
      done < <(git ls-tree -r --name-only "$stash_ref^3" 2>/dev/null)
    fi

    local desc="$stash_ref ($sha${branch_status:+, $branch_status})"
    if [[ $total_files -gt 0 && $matched_files -eq $total_files ]]; then
      say_note "$desc: fully merged (all $total_files files in $base)"
      say_note "  drop with: git stash drop $stash_ref"
    elif [[ $matched_files -gt 0 ]]; then
      say_note "$desc: partially merged ($matched_files/$total_files files in $base)"
      say_note "  unmatched (edited after, or not merged): ${unmatched[*]}"
      say_note "  drop with: git stash drop $stash_ref"
    else
      say_note "$desc: not merged"
    fi
  done <<< "$stash_list"
  say_finish "Finish checking leftover stashes"
}

# Clean up remote and local branches
function gcl() {
  git_prune_remote
  git_remove_merged_worktrees
  git_remove_merged_local_branch
  git_remove_squash_merged_local_branch
  git_remove_upstream_merged_local_branch
  if [[ $REMOTE_DELETE == 1 || $DRY_RUN == 1 ]]; then git_remove_merged_remote_branches; fi
  git_report_stashes
}

gcl

act git gc
