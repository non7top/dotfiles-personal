# Deterministic per-username color: same user always gets the same
# color (via cksum hash), so different accounts (e.g. across profiles
# or hosts) are visually distinguishable at a glance in the prompt.
function _prompt_user_color() {
    local colors=(31 32 33 34 35 36)  # red green yellow blue magenta cyan
    local h
    h=$(printf '%s' "$1" | cksum | cut -d' ' -f1)
    echo "${colors[$(( h % ${#colors[@]} ))]}"
}

# Visible length of a not-yet-decoded PS1 fragment: strips the
# literal (still-uninterpreted) \[ \] markers and \e[...m sequences,
# which only become real escape bytes once bash decodes PS1 for
# display -- at build time here they're still literal text.
function _prompt_visible_len() {
    local s=$1
    s=${s//\\[/}
    s=${s//\\]/}
    s=$(printf '%s' "$s" | sed -E 's/\\e\[[0-9;]*m//g')
    echo "${#s}"
}

# Multi-session history: histappend stops the last-exiting session from
# overwriting ~/.bash_history; `history -a` in build_prompt appends each
# command as soon as it finishes, so parallel (or crashed) sessions all
# land in the file. A new session reads everything written before it
# started; a running session deliberately does NOT pull in other
# sessions' commands live (add `history -n` next to `history -a` for that).
shopt -s histappend
HISTSIZE=100000
# lines, not bytes: ~1M lines of avg ~20-25B (command + timestamp line
# per entry) keeps the file around 20MB
HISTFILESIZE=1000000
HISTCONTROL=ignoreboth
HISTTIMEFORMAT='%F %T '

function build_prompt() {
    local ret=$?
    # after ret: history -a would clobber $? for the error segment
    history -a

    local err_seg=""
    if [ "$ret" -gt 0 ] && [ "$ret" -ne 130 ]; then
        err_seg="\[\e[41;93m\][$ret]\[\e[0m\] "
    fi

    local ucolor
    ucolor=$(_prompt_user_color "$USER")
    local user_seg="\[\e[1;${ucolor}m\]${USER}\[\e[0m\]"

    local mid="$(app_prompt)\[\e[1;93m\]${AWS_PROFILE}\[\e[0;39m\] $(knife_block_prompt) $(okta_expiration_prompt) \[\e[1;37m\]|- \[\e[1;33m\]\w\[\e[0;39m\]\[\e[1;35m\]$(__git_ps1 " (%s)")\[\e[0;39m\] \[\e[1;37m\]-|\[\e[0;39m\]"

    local left="${err_seg}${user_seg} ${mid}"

    local right="\[\e[0;34;40m\]$(date +%H:%M)\[\e[0m\]"

    local left_len right_len cols pad
    left_len=$(_prompt_visible_len "$left")
    right_len=$(_prompt_visible_len "$right")
    cols=${COLUMNS:-$(tput cols 2>/dev/null || echo 80)}
    pad=$(( cols - left_len - right_len ))
    [ "$pad" -lt 1 ] && pad=1

    [ -n "${PROMPT_DEBUG:-}" ] && echo "PROMPT_DEBUG cols=$cols left_len=$left_len right_len=$right_len pad=$pad ucolor=$ucolor" >&2

    PS1="${left}$(printf '%*s' "$pad" '')${right}\n$ "
}

PROMPT_COMMAND=build_prompt

