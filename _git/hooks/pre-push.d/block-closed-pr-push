#!/bin/bash
# Block pushes to remote branches whose PR is closed/merged, including `git push origin local:merged`.
#
# Contract: work must never land on a branch whose PR is closed/merged. This is the enforcement
# point and checks the remote ref being pushed, whatever the local branch is called. The commit
# hook (pre-commit.d/block-closed-pr-branch) deliberately allows some cases (e.g. a new branch cut
# from a merged one) because it relies on this hook. Do not relax this one without re-checking it.

set -euo pipefail

# shellcheck source=../lib/closed-pr-check.sh
source "$(dirname "$(readlink -f "$0")")/../lib/closed-pr-check.sh"

# remote_repo <url>: print [HOST/]OWNER/REPO for an ssh/https/scp-style remote URL, fail otherwise
remote_repo() {
    local url=$1 host path
    if [[ $url =~ ^[a-z+]+://([^/@]+@)?([^/:]+)(:[0-9]+)?/(.+)$ ]]; then
        host=${BASH_REMATCH[2]} path=${BASH_REMATCH[4]}
    elif [[ $url =~ ^([^/@]+@)?([^/:]+):(.+)$ ]]; then
        host=${BASH_REMATCH[2]} path=${BASH_REMATCH[3]}
    else
        return 1
    fi
    path=${path%/} path=${path%.git}
    [[ $path =~ ^[^/]+/[^/]+$ ]] || return 1
    if [[ $host == github.com ]]; then echo "$path"; else echo "$host/$path"; fi
}

# gh resolves the repo from the current directory (origin), so any other remote needs its repo
# taken from its URL; a URL that does not name a repo (e.g. a local path) cannot be checked
repo=""
if [[ "${1:-}" != "origin" ]]; then
    repo=$(remote_repo "${2:-}") || exit 0
fi

ret=0
while read -r _ local_sha remote_ref _; do
    [[ "$remote_ref" == refs/heads/* ]] || continue
    # Deleting a branch is how a merged one gets cleaned up
    [[ "$local_sha" =~ ^0+$ ]] && continue

    branch=${remote_ref#refs/heads/}
    [[ "$branch" == "main" || "$branch" == "master" || "$branch" == "develop" ]] && continue

    closed_pr_check "$branch" "Push" "$repo" || ret=1
done

exit $ret
