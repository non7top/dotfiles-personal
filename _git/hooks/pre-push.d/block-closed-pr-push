#!/bin/bash
# Block pushes to remote branches whose PR is closed/merged, including `git push origin local:merged`.

set -euo pipefail

# shellcheck source=../lib/closed-pr-check.sh
source "$(dirname "$(readlink -f "$0")")/../lib/closed-pr-check.sh"

# gh resolves the repo from the default remote, so only pushes to origin can be checked
[[ "${1:-}" == "origin" ]] || exit 0

ret=0
while read -r _ local_sha remote_ref _; do
    [[ "$remote_ref" == refs/heads/* ]] || continue
    # Deleting a branch is how a merged one gets cleaned up
    [[ "$local_sha" =~ ^0+$ ]] && continue

    branch=${remote_ref#refs/heads/}
    [[ "$branch" == "main" || "$branch" == "master" || "$branch" == "develop" ]] && continue

    closed_pr_check "$branch" "Push" || ret=1
done

exit $ret
