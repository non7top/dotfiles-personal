#!/usr/bin/env bash
# Run local hook if exists
HOOK=${1:-pre-commit}
# The common dir, not .git: in a linked worktree .git is a file and the hooks live in the main repo
LOCAL_HOOK="$(git rev-parse --path-format=absolute --git-common-dir)/hooks/$HOOK"

if [ -e "$LOCAL_HOOK" ]; then
  echo "Executing local hook $HOOK"
  "$LOCAL_HOOK" "$@"
else
  exit 0
fi
