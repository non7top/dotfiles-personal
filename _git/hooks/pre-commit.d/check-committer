#!/usr/bin/env bash
# Commit email must match the per-domain default in [user "default"] (see ~/.gitconfig.local).
# Domains with no default configured, and repos without an origin, are not checked.
origin="$(git config --get remote.origin.url)" || exit 0
origin_domain=$( echo "$origin" | sed 's|.*//||; s|.*@||; s|/.*||; s|:.*||' | sed -e 's#\.#-#g' )

default_for_domain="$( git config --get "user.default.${origin_domain}" )" || exit 0
current_email="$( git config --get user.email )"

if [ "$current_email" != "$default_for_domain" ]; then
    echo "Incorrect user is set for this origin, please doublecheck"
    echo "git config user.email $default_for_domain"
    exit 1
fi
