#!/bin/bash
# Allow multiple hooks: run git-lfs, then every script in pre-push.d/. Each gets the ref list on stdin.

if ! command -v git-lfs >/dev/null 2>&1; then
    printf '\nThis repository is configured for Git LFS but '"'"'git-lfs'"'"' was not found on your path. If you no longer wish to use Git LFS, remove this hook by deleting the '"'"'pre-push'"'"' file in the hooks directory (set by '"'"'core.hookspath'"'"'; usually '"'"'.git/hooks'"'"').\n\n' >&2
    exit 2
fi

refs=$(mktemp)
trap 'rm -f "$refs"' EXIT
cat > "$refs"

ret=0
git lfs pre-push "$@" < "$refs" || ret=1

for file in "${BASH_SOURCE[0]}.d"/*; do
    "$file" "$@" < "$refs" || ret=1
done

exit $ret
